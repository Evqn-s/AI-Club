# ──────────────────────────────────────────────
# AI Club Website — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────

# ── Frontend (exposed to browser via Vite) ────
# These are public — safe to be in the bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Vercel Edge Functions (server-side only) ──
# These are private — never sent to the browser.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Supabase Edge Function: discord-sync ──────
# Set this in Supabase dashboard → Settings → Edge Functions → Secrets.
# Your Discord bot sends this as the Authorization header when posting announcements.
# Leave blank until you have a bot — the function will return a 500 until it's set.
DISCORD_BOT_TOKEN=paste-your-discord-bot-token-here
